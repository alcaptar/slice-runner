{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "extra-files": [
        {"type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version"},
        {"type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value==\"slice-runner\")].version"},
        {"type": "toml", "path": "tui/Cargo.toml", "jsonpath": "$.package.version"},
        {"type": "toml", "path": "tui/Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"slice-runner-tui\")].version"}
      ]
    }
  }
}
